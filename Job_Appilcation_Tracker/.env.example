# Flask Settings
SECRET_KEY=dev-secret-key-job-tracker
DEBUG=True

# Google OAuth 2.0 Client ID & Secret (for Google Login & Gmail Intelligence)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/gmail/callback

# Groq AI Model Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen-2.5-32b-it

# SMTP Email Configuration (Gmail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
