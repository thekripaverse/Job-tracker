# Flask Settings
SECRET_KEY=dev-secret-key-job-tracker
DEBUG=True
ENV=development
# Hosting port (Render/Heroku set PORT; local default 5000).
PORT=5000
# Background email scheduler: 1 to keep hourly reminders in-process, 0 to
# disable (multi-worker setups or an external cron in a later phase).
SCHEDULER_ENABLED=1

# Database: SQLite default (database/tracker.db). Set DATABASE_URL to use Supabase Postgres.
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Security (Phase 1.5): Fernet key for Gmail token encryption (required in prod).
# Generate: python -c "from services.security import generate_token_encryption_key; print(generate_token_encryption_key())"
TOKEN_ENCRYPTION_KEY=
# Dev-only Gmail mocks (default OFF; never enable in production).
DEV_ALLOW_MOCKS=
# Max resume upload MB (default 8).
MAX_RESUME_MB=8
# Vercel Cron / external cron secret for /api/cron/* (Bearer or ?key=).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset = cron endpoints refuse everything. Never commit the real value.
CRON_SECRET=
# Supabase Storage (server-side only; service key never leaves the backend).
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_STORAGE_BUCKET=job-tracker-files
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0 Client ID & Secret (for Google Login & Gmail Intelligence)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/gmail/callback

# Groq AI Model Configuration (live-verified: openai/gpt-oss-120b primary)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# SMTP Email Configuration (Gmail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
