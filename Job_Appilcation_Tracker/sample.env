# ==============================================================================
# Job & Internship Tracker - Environment Configuration Template
# Copy this file to `.env` and fill in your actual credentials:
# cp sample.env .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flask Application Core Settings
# ------------------------------------------------------------------------------
# Secret key for session encryption & CSRF protection
SECRET_KEY=dev-secret-key-job-tracker-change-in-production

# Environment: development or production.
# Production (ENV=production) REQUIRES an explicit SECRET_KEY, forces
# DEBUG=False and Secure cookies; the app refuses to boot otherwise.
ENV=development

# Enable debug mode for local development ONLY (True / False).
# Ignored in production.
DEBUG=True

# Custom SQLite Database path (Optional, defaults to database/tracker.db)
# DATABASE_PATH=database/tracker.db

# PostgreSQL (Supabase) connection — Phase 1 migration.
# When set, the app uses PostgreSQL instead of SQLite (rollback: unset it).
# Get from Supabase Dashboard → Project Settings → Database → Connection string.
# Example: DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# DATABASE_URL=


# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 & Gmail Email Intelligence Integration
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console (https://console.cloud.google.com/apis/credentials):
# 1. Enable "Gmail API" and "Google People API / OAuth2 API".
# 2. Create an OAuth 2.0 Client ID (Web application).
# 3. Add Authorized redirect URI: http://127.0.0.1:5000/auth/google/gmail/callback
#    (or http://localhost:5000/auth/google/gmail/callback)

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/gmail/callback


# ------------------------------------------------------------------------------
# 3. Groq AI Configuration (AI Career Assistant, Email Classifier, & Reply Drafter)
# ------------------------------------------------------------------------------
# Obtain your free API key from Groq Console (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM model name (live-verified: openai/gpt-oss-120b, fallback openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b


# ------------------------------------------------------------------------------
# 4. SMTP Email Configuration (Daily Digest & 24h Event Reminder Notifications)
# ------------------------------------------------------------------------------
# For Gmail SMTP: Use your Gmail address and a 16-character Google "App Password"
# (https://myaccount.google.com/apppasswords - requires 2-Step Verification enabled)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password


# ------------------------------------------------------------------------------
# 5. Phase 1.5 Security Settings (placeholders only — never real secrets)
# ------------------------------------------------------------------------------
# Fernet key for encrypting stored Gmail OAuth tokens at rest.
# Generate: python -c "from services.security import generate_token_encryption_key; print(generate_token_encryption_key())"
# Required in production when Gmail is connected.
TOKEN_ENCRYPTION_KEY=

# Explicit local-dev Gmail mocks (default OFF = fail closed).
# NEVER enable in production.
DEV_ALLOW_MOCKS=

# Max resume upload size in MB (default 8).
MAX_RESUME_MB=8

# ------------------------------------------------------------------------------
# 6. Supabase Storage (Phase 2 — server-side only, never exposed to browser)
# ------------------------------------------------------------------------------
# Project URL + bucket (public values, safe in docs):
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_STORAGE_BUCKET=job-tracker-files
# Service-role key (SECRET — set only in .env / hosting secrets, never commit):
SUPABASE_SERVICE_ROLE_KEY=
