# Credentials and Environment Secrets (never commit real values)
.env
*.env
.env.*
!.env.example

# Python / Bytecode
__pycache__/
*.py[cod]
*$py.class
venv/
ENV/

# Database files (local dev + pre-migration backups stay local)
database/*.db
database/*.bak
instance/*.db

# Local-only upload staging (Supabase Storage is the production store)
instance/uploads/resumes/

# Logs (may contain request details; stdout/stderr only in production)
*.log

# Pytest / Coverage
.pytest_cache/
